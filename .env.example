# 複製成 .env 後填入真實值。.env 已被 .gitignore 排除，切勿提交。

# ===== LLM 設定 =====
# 目前使用 OpenAI。要換模型時，主要改 agents/base_agent.py 的 get_llm()，
# 並在這裡填上對應的變數即可。
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# 模型分級（選填，省成本/擋速率，白皮書 §25 P1-7）：沒設則全部用上面的 OPENAI_MODEL（＝現況）。
# 想省錢就讓調度/簡單任務用便宜模型、難任務（analyst）才用強模型：
# OPENAI_MODEL_FAST=gpt-4o-mini      # supervisor 路由用
# OPENAI_MODEL_STRONG=gpt-4o         # analyst 決策分析用
# 撞 OpenAI rate limit 時自動重試的次數（內建指數退避）。
OPENAI_MAX_RETRIES=2

# ===== 觀測：LangSmith tracing（選填，白皮書 §25 P1-9）=====
# 設了就把每次 agent 呼叫鏈上傳 LangSmith，能看「請求經過哪些 agent、各自耗時/token/錯誤」。
# 在 smith.langchain.com 註冊（個人免費額度足夠）→ Settings→API Keys 建一把 lsv2_... 貼下面。
# LangChain 看這幾個 env 自動 trace，程式不用改；不設或 false 則完全不啟用、零影響。
# 帳號在 EU 區的話加 LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_PROJECT=erp-agent

# ===== 簡報配圖（選填）=====
# Pexels 免費圖庫 API key（https://www.pexels.com/api/ 申請）。
# 填了之後，ppt 簡報才會自動配上相關照片；留空則退回純文字版面，不影響產出。
PEXELS_API_KEY=

# ===== 簡報產出引擎：ppt-agent（預設，python-pptx）=====
# ppt-agent 是【獨立部署的 sibling 服務】（預設在 ../agents/ppt-agent，自帶 venv/容器）。
# erp-agent 不 import 它的程式碼，只透過 MCP 連線（URL）。產出寫到 ./generated（= api 的 /files）。
#   PPT_AGENT_TRANSPORT : sse | stdio
#       - sse  ：連一個跑起來的 ppt-agent 服務（start.sh 會用它自己的 docker 容器帶起）。
#       - stdio：本機由 api 直接 spawn 子行程（需先建好 ppt-agent/.venv），無需 docker。
#   PPT_AGENT_URL  : transport=sse 時連的位址（start.sh 會自動設成 http://127.0.0.1:<PPT_AGENT_PORT>/sse）
#   PPT_AGENT_PORT : ppt-agent 容器對外 port（預設 8002）
#   PPT_AGENT_DIR  : ppt-agent 專案路徑（預設 ../agents/ppt-agent；給 start.sh 帶容器、與 stdio 退路用）
#   OUTPUTS_DIR    : ppt-agent 寫檔目錄；需與 api 的 /files 同處（start.sh 會設成 ./generated）
# 多數情況不必手動設這些，start.sh 會處理好。要強制 stdio：PPT_AGENT_TRANSPORT=stdio
#PPT_AGENT_TRANSPORT=sse
#PPT_AGENT_PORT=8002
#PPT_AGENT_DIR=../agents/ppt-agent

# ===== 回滾：改用舊版 Presenton 簡報引擎（選填）=====
# 設 USE_PRESENTON_PPT=true 即切回舊路徑（ppt agent 改用 Presenton 的 create_pptx）。
# 此時才需要下列設定，並用 docker compose up -d presenton 啟動 Presenton。
# Port：對外預設 5001。⚠️ macOS 的 5000 被 AirPlay 佔用,所以不要用 5000。
USE_PRESENTON_PPT=false
PRESENTON_PORT=5001
PRESENTON_URL=http://localhost:5001
PRESENTON_TEMPLATE=general
PRESENTON_USER=your-presenton-account
PRESENTON_PASSWORD=your-presenton-password
# 失敗時自動重試幾次再放棄；想 fail-fast 設 1。
PRESENTON_RETRIES=2

# ===== PostgreSQL（sql / analyst agent 查詢用）=====
# 私有 cluster 跑在 5433 port、trust 認證（純本機開發）。
# 啟動：bash db/pg.sh init（首次）/ start；灌資料：venv/bin/python -m db.seed
DATABASE_URL=postgresql://erp@localhost:5433/erp
# sql/analyst 查詢走連線池（P1-3），這是每行程的連線數上限（多 replica 時 ×replica 數要 < PG max_connections）。
DB_POOL_MAX=10

# ===== 產物交付：物件儲存（MinIO/S3，選用）=====
# 設了就把 ppt 等產物存到物件儲存：ppt-agent 上傳、erp-api 的 /files 從同一 bucket 串流，
# 兩者不再共用磁碟（可跨節點，白皮書 §25 P0-2）。沒設則維持讀本地 generated/（單機）。
# 本機測試：docker run -p 9000:9000 minio/minio server /data，再填下面四項。
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=erp-outputs
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ===== 對話記憶（LangGraph checkpointer）=====
# 設了就把對話記憶持久化到 Postgres（解鎖 erp-agent 多 replica、重啟記憶不消失）；
# 連不上或不設則自動退回 RAM（MemorySaver）。不設時預設沿用上面的 DATABASE_URL。
# 想把記憶和業務資料分庫，改指向另一個 database 即可（其餘程式不動）。
# CHECKPOINT_DATABASE_URL=postgresql://erp@localhost:5433/erp
